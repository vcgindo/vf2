# Stage 3 portable template. Set deployment-specific values outside source control.
DEBUG=false
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vectorflow_user
DB_USER=vectorflow
DB_PASSWORD=<compatible-encrypted-password-required-by-preserved-service>
USER_SERVICE_RSA_PRIVATE_KEY_PATH=/run/secrets/user-service-private-key.pem
USER_SERVICE_RSA_PUBLIC_KEY_PATH=/run/secrets/user-service-public-key.pem
DB_BACKUP_FOLDER=<set-an-approved-writable-path>
SECRET_KEY=<set-a-unique-secret>
SECRET_KEY_FOR_PASSWORD=<set-the-preserved-service-key-material>
PASSWORD_RESET_TIMEOUT=28800
API_BLOCKING_TIME=60
API_BLOCKING_LIMITS=15
BASE_CLIENT_URL=http://localhost:3000
ALLOWED_SSL=localhost,127.0.0.1
EMAIL_HOST=<set-locally>
EMAIL_PORT=587
EMAIL_HOST_USER=<set-locally>
EMAIL_HOST_PASSWORD=<set-locally>
DEFAULT_FROM_EMAIL=<set-locally>
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
