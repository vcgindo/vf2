# DO NOT MODIFY FRONTEND CODE OR THE MTO STACK. Preserve the original frontend presentation and behavior. No frontend redesign, substitute screens, refactoring or MTO changes. Any future exception requires explicit human authorization.
# Copy to .env (ignored by Git). Use a NEW project; existing databases are never reset.
VF_PROJECT=vectorflow
VF_IMAGE_PREFIX=${VF_PROJECT}
VF_RELEASE=source
VF_BIND_ADDRESS=127.0.0.1
VF_HTTP_PORT=8080
VF_PUBLIC_URL=http://127.0.0.1:${VF_HTTP_PORT}
VF_PUBLIC_WS_URL=ws://127.0.0.1:${VF_HTTP_PORT}
# Native pins are automatically supplied by the newly built immutable image.
VF_NATIVE_RELEASE_COMMIT=image
VF_NATIVE_RELEASE_SHA256=image
VF_SOURCE_MANIFEST_SHA256=image
# Intentionally PUBLIC browser cipher, not a signing/database/RSA secret.
VF_CLIENT_CIPHER_KEY=4468c3e3a8d5d468558c4f2198c2c400
# Preserve the accepted MTO BM-report page-size configuration.
VF_MTO_BM_REPORT_ROWS_PER_PAGE=5000
# Explicitly supplied or prompted during the ONE blank-install command.
VF_ADMIN_EMAIL=
VF_ADMIN_NAME=
VF_ADMIN_PASSWORD=
# Optional SMTP. Blank host leaves email/password reset unavailable; no password is changed.
# STARTTLS: port587, TLS=true/SSL=false. Implicit TLS: port465, TLS=false/SSL=true.
# Use your provider's authorized sender and app password. Keep .env private/outside Git.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_NAME=VectorFLOW
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
POSTGRES_IDLE_TIMEOUT=30s
POSTGRES_STATEMENT_TIMEOUT=300s
POSTGRES_LOCK_TIMEOUT=5s
MTA_WORKERS=1

# Optional build-only tuning; blank uses Node defaults. Runtime has no prescribed CPU/memory ceiling.
FRONTEND_BUILD_HEAP_MIB=
VF_CONSTRAINED_BUILD=0

# Optional daily CSV operation; absolute private host paths, not business data in Git.
# One-time CSV setup: set this pack directory, then run ./vf.ps1 csv-init.
# The launcher writes the daily binding/access settings below automatically.
VF_CSV_INPUT_DIR=
# Completed date folders live under INPUT_DIR. Binding file stays beside its original onboarding files.
VF_DAILY_INPUT_DIR=
VF_DAILY_BINDING_FILE=
VF_DAILY_STATE_DIR=
