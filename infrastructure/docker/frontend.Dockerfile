FROM node:20.18-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
ARG REACT_APP_API_HOST=/
ARG REACT_APP_VF_API_HOST_MTO=/api/mto
ARG REACT_APP_ENABLE_LOCAL_LOGIN=true
ARG REACT_APP_SECRET_KEY
ARG REACT_APP_WS_API_HOST=ws://localhost:3000
ARG REACT_APP_MTO_BM_REPORT_ROWS_PER_PAGE=5000
ARG REACT_APP_DEMO_MODE=false
ENV REACT_APP_API_HOST=$REACT_APP_API_HOST \
    REACT_APP_VF_API_HOST_MTO=$REACT_APP_VF_API_HOST_MTO \
    REACT_APP_ENABLE_LOCAL_LOGIN=$REACT_APP_ENABLE_LOCAL_LOGIN \
    REACT_APP_SECRET_KEY=$REACT_APP_SECRET_KEY \
    REACT_APP_WS_API_HOST=$REACT_APP_WS_API_HOST \
    REACT_APP_MTO_BM_REPORT_ROWS_PER_PAGE=$REACT_APP_MTO_BM_REPORT_ROWS_PER_PAGE \
    REACT_APP_DEMO_MODE=$REACT_APP_DEMO_MODE \
    NODE_OPTIONS=--max-old-space-size=4096 \
    GENERATE_SOURCEMAP=false
RUN npm run build
FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY infrastructure/docker/frontend-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
