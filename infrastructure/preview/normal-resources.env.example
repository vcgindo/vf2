# Local normal-serving sizing, independent of external comparison harnesses.
# Memory-swap is the combined RAM+swap ceiling. Equal values disable swap.
SERVE_MTA_CPUS=3
SERVE_MTA_MEMORY=4g
SERVE_MTA_MEMORY_SWAP=4g
SERVE_MTA_WORKERS=2
SERVE_MTA_TIMEOUT=180
SERVE_AUTH_CPUS=1
SERVE_AUTH_MEMORY=1g
SERVE_AUTH_MEMORY_SWAP=2g
SERVE_AUTH_WORKERS=1
SERVE_MTO_CPUS=1
SERVE_MTO_MEMORY=1g
SERVE_MTO_MEMORY_SWAP=2g
SERVE_FRONTEND_CPUS=0.5
SERVE_FRONTEND_MEMORY=128m
SERVE_FRONTEND_MEMORY_SWAP=256m
SERVE_REDIS_CPUS=0.5
SERVE_REDIS_MEMORY=128m
SERVE_REDIS_MEMORY_SWAP=256m
SERVE_PG_CPUS=2
SERVE_PG_MEMORY=2g
SERVE_PG_MEMORY_SWAP=2g
