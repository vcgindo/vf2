# Copy to .env outside Git. Set VF_RELEASE to the exported release's source commit.
VF_PROJECT=vectorflow
VF_RELEASE=
VF_IMAGE_PREFIX=vectorflow
# Loopback HTTP example only. External deployment requires HTTPS/TLS override.
VF_BIND_ADDRESS=127.0.0.1
VF_HTTP_PORT=8080
VF_PUBLIC_URL=http://127.0.0.1:8080
VF_PUBLIC_WS_URL=ws://127.0.0.1:8080
VF_ALLOWED_HOSTS=127.0.0.1,localhost,mta,mto,auth
VF_TLS_MODE=http
# For TLS include compose.tls.yaml, use public https/wss URLs and e.g. port443.
VF_TLS_CERTIFICATE_FILE=
VF_TLS_PRIVATE_KEY_FILE=
VF_SECRETS_DIR=./secrets
# This is public browser cipher configuration, matching auth. No signing/DB secrets here.
VF_CLIENT_CIPHER_KEY=
# Optional public override; blank preserves the exact existing AG Grid Enterprise key.
REACT_APP_AG_GRID_LICENSE_KEY=
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=5
PG_ADMIN_USER=postgres
MTA_DB_NAME=vectorflow_mta
MTO_DB_NAME=vectorflow_mto
MTA_OWNER_ROLE=vectorflow_mta_owner
MTA_INSTALLER_ROLE=vectorflow_mta_installer
MTA_RUNTIME_ROLE=vectorflow_mta_runtime
MTO_OWNER_ROLE=vectorflow_mto_owner
MTO_INSTALLER_ROLE=vectorflow_mto_installer
MTO_RUNTIME_ROLE=vectorflow_mto_runtime
AUTH_OWNER_ROLE=vectorflow_auth_owner
AUTH_INSTALLER_ROLE=vectorflow_auth_installer
AUTH_RUNTIME_ROLE=vectorflow_auth_runtime
# Native publication is absent on a new install. No customer/test data is imported.
# Provide paths INSIDE the mta_data volume only after legitimate native initialization/publication.
MTA_SELECTION_FILE=
MTA_PERMISSIONS_FILE=
MTA_PERMISSIONS_SHA256=
MTA_HIERARCHY_FILE=
MTA_HIERARCHY_SHA256=
MTA_ACTION_TIME_ZONE=Asia/Kolkata
MTA_WORKERS=2
MTA_TIMEOUT=180
MTA_GRACEFUL_TIMEOUT=30
AUTH_WORKERS=1
AUTH_KEEP_ALIVE=5
PASSWORD_RESET_TIMEOUT=28800
MTO_HTTP_TIMEOUT=180
MTO_WEBSOCKET_CONNECT_TIMEOUT=30
MTO_WEBSOCKET_PING_INTERVAL=20
MTO_WEBSOCKET_PING_TIMEOUT=30
VF_PROXY_READ_TIMEOUT=180
LOG_LEVEL=INFO
VF_LOG_MAX_SIZE=10m
VF_LOG_FILES=3
MTA_MEMORY=4g
MTA_CPUS=2
AUTH_MEMORY=1g
AUTH_CPUS=1
MTO_MEMORY=1g
MTO_CPUS=1
POSTGRES_MEMORY=1g
POSTGRES_CPUS=1
REDIS_MEMORY=128m
REDIS_CPUS=0.5
FRONTEND_MEMORY=128m
FRONTEND_CPUS=0.5
EMAIL_HOST=
EMAIL_USER=

# Optional verified-server PostgreSQL TLS: add compose.db-tls.yaml and supply CA file.
VF_DB_CA_FILE=
